<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime -> Resource Access -> Audio Input. Apple documents
	     this as the entitlement that lets an app record from the built-in
	     microphone and use Core Audio input. Without it the runtime turns the
	     request down before TCC puts a dialog up, so the app never appears in
	     the microphone pane either. The Lite build is sandboxed and has its
	     own file; every other build is hardened but not sandboxed, and still
	     needs this one on the binary. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
